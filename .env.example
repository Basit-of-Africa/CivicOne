# ---------------------------------------------------------------------------
# CivicOne Nigeria — environment variables
# Copy this file to `.env` and adjust values. Never commit real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/civicone"

# Optional NG Data API reference-data integration. CivicOne keeps local fallback data.
NG_DATA_API_URL="https://ngdata.udeh.ng"
NG_DATA_API_KEY=""
NG_DATA_CACHE_TTL_SECONDS="86400"

# Public URL of the application (used to build absolute links in emails)
APP_URL="http://localhost:3000"

# Application identity
APP_NAME="CivicOne Nigeria"
EMAIL_FROM="no-reply@civicone.ng"

# Session cookie
SESSION_COOKIE_NAME="civone_session"
# Set to true behind HTTPS in production. Next.js dev over http must be false.
SESSION_COOKIE_SECURE="false"

# Session lifetime (seconds). Default 7 days.
SESSION_MAX_AGE_SECONDS="604800"

# Email verification link lifetime (seconds). Default 24 hours.
EMAIL_VERIFICATION_TTL_SECONDS="86400"

# Password reset link lifetime (seconds). Default 1 hour.
PASSWORD_RESET_TTL_SECONDS="3600"

# Rate limiting
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_MAX_ATTEMPTS="5"
RATE_LIMIT_WINDOW_MS="900000"

# Identity verification
# AES-256-GCM key material used to encrypt stored identity credentials (NIN).
# MUST be replaced with a strong random value in production (e.g. `openssl rand -hex 32`).
IDENTITY_ENCRYPTION_KEY="change-me-this-is-a-development-only-key-0123456789abcdef"

# Phase 6C — Paystack (Payment Gateway)
# Get keys from https://dashboard.paystack.com/#/settings/api
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_WEBHOOK_SECRET=""

# Phase 6C — Resend (Email Delivery)
# Get API key from https://resend.com/api-keys
RESEND_API_KEY=""
