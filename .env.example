# ---------------------------------------------------------------------------
# CivicOne Nigeria — environment variables
# Copy this file to `.env` and adjust values. Never commit real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/civicone"

# Public URL of the application (used to build absolute links in emails)
APP_URL="http://localhost:3000"

# Application identity
APP_NAME="CivicOne Nigeria"
EMAIL_FROM="no-reply@civicone.ng"

# Session cookie
SESSION_COOKIE_NAME="civone_session"
# Set to true behind HTTPS in production. Next.js dev over http must be false.
SESSION_COOKIE_SECURE="false"

# Session lifetime (seconds). Default 7 days.
SESSION_MAX_AGE_SECONDS="604800"

# Email verification link lifetime (seconds). Default 24 hours.
EMAIL_VERIFICATION_TTL_SECONDS="86400"

# Password reset link lifetime (seconds). Default 1 hour.
PASSWORD_RESET_TTL_SECONDS="3600"

# Rate limiting
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_MAX_ATTEMPTS="5"
RATE_LIMIT_WINDOW_MS="900000"
