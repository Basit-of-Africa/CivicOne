// CivicOne Nigeria — Phase 1 database foundation
//
// Core tables: users, profiles, roles, user_roles, sessions,
// email_verifications, password_resets, audit_logs.
//
// Identity tables exist as placeholders only. NIN storage is NOT
// implemented — that belongs to Phase 2.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users
// ---------------------------------------------------------------------------

model User {
  id           String     @id @db.VarChar(64) // opaque, application-generated (usr_...)
  email        String?    @unique @db.VarChar(320)
  phone        String?    @unique @db.VarChar(32)
  passwordHash String?    @map("password_hash") @db.VarChar(128)
  status       UserStatus @default(UNVERIFIED)
  emailVerifiedAt DateTime? @map("email_verified_at")
  phoneVerifiedAt DateTime? @map("phone_verified_at")
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  profile            Profile?
  identityProfile    IdentityProfile?
  sessions           Session[]
  userRoles          UserRole[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]
  auditLogs          AuditLog[]

  @@map("users")
}

enum UserStatus {
  UNVERIFIED // registered, not yet identity-verified (Phase 1 default)
  VERIFIED
  SUSPENDED
  LOCKED
  CLOSED
}

// ---------------------------------------------------------------------------
// Profiles
// ---------------------------------------------------------------------------

model Profile {
  id         String   @id @db.VarChar(64) // opaque, application-generated (prf_...)
  userId     String   @unique @map("user_id") @db.VarChar(64)
  firstName  String?  @map("first_name") @db.VarChar(80)
  lastName   String?  @map("last_name") @db.VarChar(80)
  middleName String?  @map("middle_name") @db.VarChar(80)
  title      String?  @db.VarChar(80)
  dateOfBirth DateTime? @map("date_of_birth")
  gender     Gender?
  avatarUrl  String?  @map("avatar_url") @db.VarChar(512)
  country    String?  @default("NG") @db.VarChar(2)
  state      String?  @db.VarChar(80)
  city       String?  @db.VarChar(80)
  address    String?  @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

enum Gender {
  MALE
  FEMALE
  PREFER_NOT_TO_SAY
}

// ---------------------------------------------------------------------------
// Roles & authorisation
// ---------------------------------------------------------------------------

model Role {
  id          String   @id @db.VarChar(64)
  name        RoleName @unique
  label       String   @db.VarChar(80)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userRoles UserRole[]

  @@map("roles")
}

enum RoleName {
  USER
  PROFESSIONAL
  SERVICE_ADMIN
  CONTENT_ADMIN
  IDENTITY_ADMIN
  SUPER_ADMIN
}

model UserRole {
  id        String   @id @db.VarChar(64)
  userId    String   @map("user_id") @db.VarChar(64)
  roleId    String   @map("role_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Sessions (server-side, opaque tokens stored hashed)
// ---------------------------------------------------------------------------

model Session {
  id           String    @id @db.VarChar(64)
  userId       String    @map("user_id") @db.VarChar(64)
  tokenHash    String    @unique @map("token_hash") @db.VarChar(64) // sha256(token)
  userAgent    String?   @map("user_agent") @db.VarChar(512)
  ipAddress    String?   @map("ip_address") @db.VarChar(64)
  createdAt    DateTime  @default(now()) @map("created_at")
  lastActiveAt DateTime  @default(now()) @map("last_active_at")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Email verification
// ---------------------------------------------------------------------------

model EmailVerification {
  id        String    @id @db.VarChar(64)
  userId    String    @map("user_id") @db.VarChar(64)
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verifications")
}

// ---------------------------------------------------------------------------
// Password reset
// ---------------------------------------------------------------------------

model PasswordReset {
  id        String    @id @db.VarChar(64)
  userId    String    @map("user_id") @db.VarChar(64)
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

// ---------------------------------------------------------------------------
// Audit log
// ---------------------------------------------------------------------------
// Structured audit trail. NEVER log passwords, tokens or future NIN data.

model AuditLog {
  id           String    @id @db.VarChar(64)
  actorId      String?   @map("actor_id") @db.VarChar(64)
  action       String    @db.VarChar(80)
  resourceType String?   @map("resource_type") @db.VarChar(80)
  resourceId   String?   @map("resource_id") @db.VarChar(64)
  metadata     Json?
  ipAddress    String?   @map("ip_address") @db.VarChar(64)
  userAgent    String?   @map("user_agent") @db.VarChar(512)
  createdAt    DateTime  @default(now()) @map("created_at")

  user User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Identity (Phase 2 placeholder — NO NIN storage in Phase 1)
// ---------------------------------------------------------------------------

model IdentityProfile {
  id                   String                      @id @db.VarChar(64)
  userId               String                      @unique @map("user_id") @db.VarChar(64)
  verificationStatus   IdentityVerificationStatus  @default(UNVERIFIED) @map("verification_status")
  verifiedAt           DateTime?                   @map("verified_at")
  createdAt            DateTime                    @default(now()) @map("created_at")
  updatedAt            DateTime                    @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("identity_profiles")
}

enum IdentityVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}
